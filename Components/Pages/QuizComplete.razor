@page "/quiz/{ShareCode}/complete/{AttemptId:int}"
@rendermode InteractiveServer
@inject IStringLocalizer<SharedResource> L
@inject AttemptService AttemptSvc
@inject NavigationManager Nav

<PageTitle>@L["YourScore"] — @L["AppTitle"]</PageTitle>

<div class="container--narrow" style="margin-inline: auto;">
    @if (loading)
    {
        <div class="text-center mt-xl"><p class="text-muted">...</p></div>
    }
    else if (attempt == null)
    {
        <div class="not-found animate-fade-in">
            <h2>@L["QuizNotFound"]</h2>
            <a href="/" class="btn btn-primary mt-lg">@L["BackHome"]</a>
        </div>
    }
    else
    {
        <div class="score-reveal animate-fade-in">
            <div class="score-circle animate-scale-in">
                <div class="score-number">@attempt.Score</div>
                <div class="score-total">@L["Of"] @attempt.TotalQuestions</div>
            </div>

            <h2 class="delay-1 animate-fade-in">@L["YourScore"]</h2>
            <p class="score-percentage delay-2 animate-fade-in">
                @(attempt.TotalQuestions > 0 ? Math.Round((double)attempt.Score / attempt.TotalQuestions * 100) : 0)%
            </p>
        </div>

        @* Question-by-question review *@
        <div class="section-title">
            <h3>@L["Results"]</h3>
        </div>

        @foreach (var question in attempt.Quiz.Questions.OrderBy(q => q.OrderIndex))
        {
            var answer = attempt.Answers.FirstOrDefault(a => a.QuestionId == question.Id);
            var isCorrect = answer?.IsCorrect ?? false;
            var correctOption = question.Options.FirstOrDefault(o => o.IsCorrect);
            var selectedOption = answer != null ? question.Options.FirstOrDefault(o => o.Id == answer.SelectedOptionId) : null;

            <div class="result-item @(isCorrect ? "correct" : "incorrect") animate-fade-in">
                <div class="result-item-header">
                    <strong>@question.Text</strong>
                    <span class="result-badge @(isCorrect ? "correct" : "incorrect")">
                        @(isCorrect ? L["Correct"] : L["Incorrect"])
                    </span>
                </div>

                @if (selectedOption != null)
                {
                    <div class="result-answer">
                        <strong>@L["YourAnswer"]:</strong> @selectedOption.Text
                    </div>
                }

                @if (!isCorrect && correctOption != null)
                {
                    <div class="result-answer" style="color: var(--color-correct);">
                        <strong>@L["CorrectAnswerIs"]:</strong> @correctOption.Text
                    </div>
                }
            </div>
        }

        <div class="text-center mt-xl mb-xl">
            <a href="/" class="btn btn-primary">@L["TakeAnother"]</a>
        </div>
    }
</div>

@code {
    [Parameter] public string ShareCode { get; set; } = "";
    [Parameter] public int AttemptId { get; set; }

    private QuizAttempt? attempt;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        attempt = await AttemptSvc.GetAttemptAsync(AttemptId);
        loading = false;
    }
}
