@page "/manage/{ManageCode}"
@rendermode InteractiveServer
@inject IStringLocalizer<SharedResource> L
@inject QuizService QuizSvc
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@L["Results"] — @L["AppTitle"]</PageTitle>

<div class="container--narrow" style="margin-inline: auto;">
    @if (loading)
    {
        <div class="text-center mt-xl"><p class="text-muted">...</p></div>
    }
    else if (quiz == null)
    {
        <div class="not-found animate-fade-in">
            <h2>@L["QuizNotFound"]</h2>
            <a href="/" class="btn btn-primary mt-lg">@L["BackHome"]</a>
        </div>
    }
    else
    {
        @* Quiz Header *@
        <div class="flex-between mb-lg animate-fade-in">
            <div>
                <h2>@quiz.Title</h2>
                @if (!string.IsNullOrWhiteSpace(quiz.Description))
                {
                    <p class="text-muted text-sm mt-md">@quiz.Description</p>
                }
            </div>
            <span class="status-badge @(quiz.IsActive ? "active" : "inactive")">
                <span class="status-dot"></span>
                @(quiz.IsActive ? L["Active"] : L["Inactive"])
            </span>
        </div>

        @* Share Links *@
        <div class="share-box mb-md animate-fade-in delay-1">
            <span class="share-box-label">@L["ShareLink"]</span>
            <span class="share-box-value">@quiz!.ShareCode</span>
            <button class="btn btn-outline btn-sm" @onclick='() => CopyText(GetShareUrl())'>
                @(copiedField == "share" ? L["Copied"] : L["CopyLink"])
            </button>
        </div>

        <div class="share-box mb-xl animate-fade-in delay-2">
            <span class="share-box-label">@L["ManageLink"]</span>
            <span class="share-box-value">@quiz!.ManageCode</span>
            <button class="btn btn-outline btn-sm" @onclick='() => CopyText(GetManageUrl(), "manage")'>
                @(copiedField == "manage" ? L["Copied"] : L["CopyLink"])
            </button>
        </div>

        @* Stats *@
        <div class="stats-grid animate-fade-in delay-3">
            <div class="stat-card">
                <div class="stat-value">@quiz.Attempts.Count</div>
                <div class="stat-label">@L["TotalAttempts"]</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">
                    @if (quiz.Attempts.Any())
                    {
                        @($"{quiz.Attempts.Average(a => (double)a.Score / a.TotalQuestions * 100):0}")<span class="text-sm">%</span>
                    }
                    else { <span>—</span> }
                </div>
                <div class="stat-label">@L["AverageScore"]</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">
                    @if (quiz.Attempts.Any())
                    {
                        @quiz.Attempts.Max(a => a.Score)<span class="text-sm">/@quiz.Questions.Count</span>
                    }
                    else { <span>—</span> }
                </div>
                <div class="stat-label">@L["HighestScore"]</div>
            </div>
        </div>

        @* Attempts Table *@
        <div class="section-title">
            <h3>@L["Results"]</h3>
        </div>

        @if (!quiz.Attempts.Any())
        {
            <div class="card text-center">
                <p class="text-muted">@L["NoAttempts"]</p>
            </div>
        }
        else
        {
            <div class="card card--flat" style="overflow-x: auto;">
                <table class="attempts-table">
                    <thead>
                        <tr>
                            <th>@L["Participant"]</th>
                            <th>@L["Score"]</th>
                            <th>@L["Date"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var attempt in quiz.Attempts)
                        {
                            <tr>
                                <td>@attempt.ParticipantName</td>
                                <td class="score-cell">@attempt.Score / @attempt.TotalQuestions</td>
                                <td class="text-muted text-sm">@attempt.CompletedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                                <td>
                                    <button class="detail-toggle" @onclick="() => ToggleDetail(attempt.Id)">
                                        @(expandedAttempt == attempt.Id ? L["HideDetails"] : L["ViewDetails"])
                                    </button>
                                </td>
                            </tr>
                            @if (expandedAttempt == attempt.Id)
                            {
                                <tr class="detail-row">
                                    <td colspan="4">
                                        @foreach (var question in quiz.Questions.OrderBy(q => q.OrderIndex))
                                        {
                                            var ans = attempt.Answers.FirstOrDefault(a => a.QuestionId == question.Id);
                                            var isCorrect = ans?.IsCorrect ?? false;
                                            var selectedOpt = ans != null ? question.Options.FirstOrDefault(o => o.Id == ans.SelectedOptionId) : null;
                                            var correctOpt = question.Options.FirstOrDefault(o => o.IsCorrect);

                                            <div class="result-item @(isCorrect ? "correct" : "incorrect")" style="margin-block-end: var(--space-sm);">
                                                <div class="result-item-header">
                                                    <span>@question.Text</span>
                                                    <span class="result-badge @(isCorrect ? "correct" : "incorrect")">
                                                        @(isCorrect ? L["Correct"] : L["Incorrect"])
                                                    </span>
                                                </div>
                                                @if (selectedOpt != null)
                                                {
                                                    <div class="result-answer">
                                                        <strong>@L["YourAnswer"]:</strong> @selectedOpt.Text
                                                    </div>
                                                }
                                                @if (!isCorrect && correctOpt != null)
                                                {
                                                    <div class="result-answer" style="color: var(--color-correct);">
                                                        <strong>@L["CorrectAnswerIs"]:</strong> @correctOpt.Text
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }

        @* Actions *@
        <div class="flex-between mt-xl" style="flex-wrap: wrap; gap: var(--space-md);">
            <div class="inline-flex">
                <button class="btn btn-ghost" @onclick="ToggleActive">@L["ToggleStatus"]</button>
                <a href="/" class="btn btn-ghost">@L["BackHome"]</a>
            </div>

            @if (!showDeleteConfirm)
            {
                <button class="btn btn-danger btn-sm" @onclick="() => showDeleteConfirm = true">@L["DeleteQuiz"]</button>
            }
            else
            {
                <div class="inline-flex">
                    <span class="text-sm" style="color: var(--color-incorrect);">@L["ConfirmDelete"]</span>
                    <button class="btn btn-danger btn-sm" @onclick="DeleteQuiz">@L["DeleteQuiz"]</button>
                    <button class="btn btn-ghost btn-sm" @onclick="() => showDeleteConfirm = false">&#x2715;</button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string ManageCode { get; set; } = "";

    private Quiz? quiz;
    private bool loading = true;
    private int? expandedAttempt;
    private bool showDeleteConfirm;
    private string? copiedField;

    protected override async Task OnInitializedAsync()
    {
        quiz = await QuizSvc.GetByManageCodeAsync(ManageCode);
        loading = false;
    }

    private void ToggleDetail(int attemptId)
    {
        expandedAttempt = expandedAttempt == attemptId ? null : attemptId;
    }

    private async Task ToggleActive()
    {
        await QuizSvc.ToggleActiveAsync(ManageCode);
        quiz = await QuizSvc.GetByManageCodeAsync(ManageCode);
    }

    private async Task DeleteQuiz()
    {
        await QuizSvc.DeleteQuizAsync(ManageCode);
        Nav.NavigateTo("/");
    }

    private string GetShareUrl() => $"{Nav.BaseUri}quiz/{quiz!.ShareCode}";
    private string GetManageUrl() => $"{Nav.BaseUri}manage/{quiz!.ManageCode}";

    private async Task CopyText(string text, string field = "share")
    {
        await JS.InvokeVoidAsync("copyToClipboard", text);
        copiedField = field;
        StateHasChanged();
        await Task.Delay(2000);
        copiedField = null;
        StateHasChanged();
    }
}
