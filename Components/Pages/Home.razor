@page "/"
@rendermode InteractiveServer
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

<PageTitle>@L["AppTitle"] — @L["AppTagline"]</PageTitle>

<section class="hero animate-fade-in">
    <div class="hero-diamond animate-scale-in">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5"/>
            <path d="M2 12l10 5 10-5"/>
        </svg>
    </div>

    <h1 class="delay-1 animate-fade-in">@L["HeroTitle"]</h1>
    <p class="hero-subtitle delay-2 animate-fade-in">@L["HeroSubtitle"]</p>

    <div class="hero-actions delay-3 animate-fade-in">
        <div class="hero-cta">
            <a href="/create" class="btn btn-primary btn-lg">@L["CreateQuiz"]</a>
        </div>

        <div class="divider-text">@L["OrEnterCode"]</div>

        <div class="code-input-group">
            <input type="text"
                   class="form-input"
                   placeholder="@L["EnterCode"]"
                   @bind="quizCode"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   maxlength="8" />
            <button class="btn btn-primary" @onclick="GoToQuiz">@L["Go"]</button>
        </div>
    </div>
</section>

@code {
    private string quizCode = "";

    private void GoToQuiz()
    {
        var code = quizCode.Trim().ToUpperInvariant();
        if (!string.IsNullOrWhiteSpace(code))
        {
            Nav.NavigateTo($"/quiz/{code}");
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") GoToQuiz();
    }
}
